# Copy to .env and replace every CHANGE_ME with a distinct high-entropy value.
# .env is git-ignored and must never be committed.
#
#   openssl rand -base64 36
#
ODOO_DOMAIN=events.example.com

# Loopback-only host port. Pick one that no other project on this VPS uses.
ODOO_PORT=19069

# Database created through the controlled setup path (see deploy/README.md).
ODOO_DB=ems_production

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME

# Guards the database manager endpoints. Not an Odoo login.
ODOO_ADMIN_PASSWD=CHANGE_ME

ODOO_WORKERS=4
LETSENCRYPT_EMAIL=admin@example.com

BACKUP_DIR=/var/backups/ems-odoo
BACKUP_RETENTION_DAYS=14
