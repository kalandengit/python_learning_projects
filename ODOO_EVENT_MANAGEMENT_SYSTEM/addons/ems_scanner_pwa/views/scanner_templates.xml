<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="scanner_page" name="EMS Scanner">
    <t t-call="website.layout">
      <t t-set="head">
        <link rel="manifest" href="/ems/scanner/manifest.json"/>
        <meta name="theme-color" content="#111111"/>
      </t>
      <main class="container py-4 ems-scanner">
        <h1>EMS Scanner</h1>
        <p class="mb-1">
          Network: <span id="ems-network-state" class="fw-bold">Checking…</span>
        </p>
        <p class="text-muted" id="ems-queue-state">Offline queue empty</p>

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="mb-2">
              <label for="ems-device-uid" class="form-label">Device UID</label>
              <input id="ems-device-uid" class="form-control" autocomplete="off"/>
            </div>
            <div class="mb-2">
              <label for="ems-device-secret" class="form-label">Device secret</label>
              <input id="ems-device-secret" type="password" class="form-control"
                     autocomplete="off"/>
              <div class="form-text">
                Issued once at enrollment. Stored only on this device.
              </div>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <div class="ems-camera-wrapper mb-2">
              <video id="ems-camera" class="w-100 rounded bg-dark" muted="muted"></video>
            </div>
            <div class="d-flex gap-2">
              <button id="ems-start-camera" class="btn btn-primary" type="button">
                Start camera
              </button>
              <button id="ems-stop-camera" class="btn btn-outline-secondary" type="button"
                      disabled="disabled">
                Stop
              </button>
            </div>
            <p id="ems-camera-note" class="form-text"/>
          </div>
        </div>

        <div class="mt-3">
          <label for="ems-envelope" class="form-label">QR payload (manual entry)</label>
          <textarea id="ems-envelope" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2 mt-3">
          <button id="ems-submit-scan" class="btn btn-primary" type="button">
            Validate scan
          </button>
          <button id="ems-sync-scans" class="btn btn-outline-secondary" type="button">
            Sync offline queue
          </button>
        </div>

        <pre id="ems-scan-result" class="mt-3 p-3 bg-light rounded"></pre>
      </main>
    </t>
  </template>
</odoo>
