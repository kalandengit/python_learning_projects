<odoo>
  <record id="payment_link_list" model="ir.ui.view">
    <field name="name">ems.payment.link.list</field><field name="model">ems.payment.link</field>
    <field name="arch" type="xml"><list>
      <field name="event_id"/><field name="partner_id"/><field name="registration_id"/>
      <field name="amount"/><field name="currency_id"/><field name="transaction_id"/><field name="state"/>
    </list></field>
  </record>
  <record id="action_payment_links" model="ir.actions.act_window">
    <field name="name">Event Payments</field><field name="res_model">ems.payment.link</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_event_payments" name="Payments" parent="ems_core.menu_ems_root" action="action_payment_links" sequence="60"/>
</odoo>
