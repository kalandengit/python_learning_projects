<odoo>
  <record id="device_list" model="ir.ui.view">
    <field name="name">ems.scanner.device.list</field><field name="model">ems.scanner.device</field>
    <field name="arch" type="xml"><list>
      <field name="name"/><field name="device_uid"/><field name="active"/><field name="last_seen_at"/>
    </list></field>
  </record>
  <record id="scan_list" model="ir.ui.view">
    <field name="name">ems.scan.log.list</field><field name="model">ems.scan.log</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0">
      <field name="server_scanned_at"/><field name="event_id"/><field name="ticket_id"/>
      <field name="device_id"/><field name="result"/><field name="reason"/>
    </list></field>
  </record>
  <record id="action_ems_devices" model="ir.actions.act_window">
    <field name="name">Scanner Devices</field><field name="res_model">ems.scanner.device</field><field name="view_mode">list,form</field>
  </record>
  <record id="action_ems_scans" model="ir.actions.act_window">
    <field name="name">Scan Logs</field><field name="res_model">ems.scan.log</field><field name="view_mode">list</field>
  </record>
  <menuitem id="menu_ems_devices" name="Scanner Devices" parent="ems_core.menu_ems_root" action="action_ems_devices" sequence="40"/>
  <menuitem id="menu_ems_scans" name="Scan Logs" parent="ems_core.menu_ems_root" action="action_ems_scans" sequence="45"/>
</odoo>
