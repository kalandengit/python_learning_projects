<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_ems_device_company" model="ir.rule">
            <field name="name">EMS scanner device: multi-company</field>
            <field name="model_id" ref="model_ems_scanner_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ems_scan_log_company" model="ir.rule">
            <field name="name">EMS scan log: multi-company</field>
            <field name="model_id" ref="model_ems_scan_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
