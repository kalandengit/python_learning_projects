<odoo>
  <record id="ai_list" model="ir.ui.view">
    <field name="name">ems.ai.request.list</field><field name="model">ems.ai.request</field>
    <field name="arch" type="xml"><list>
      <field name="event_id"/><field name="task"/><field name="state"/><field name="create_date"/>
    </list></field>
  </record>
  <record id="ai_form" model="ir.ui.view">
    <field name="name">ems.ai.request.form</field><field name="model">ems.ai.request</field>
    <field name="arch" type="xml"><form>
      <header><button name="action_generate" type="object" string="Generate" invisible="state == 'done'"/>
      <field name="state" widget="statusbar"/></header>
      <sheet><group><field name="event_id"/><field name="task"/><field name="input_text"/>
      <field name="output_text" readonly="1"/><field name="error" readonly="1"/></group></sheet>
    </form></field>
  </record>
  <record id="action_ai" model="ir.actions.act_window">
    <field name="name">AI Assistant</field><field name="res_model">ems.ai.request</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_ai" name="AI Assistant" parent="ems_core.menu_ems_root" action="action_ai" sequence="75"/>
</odoo>
