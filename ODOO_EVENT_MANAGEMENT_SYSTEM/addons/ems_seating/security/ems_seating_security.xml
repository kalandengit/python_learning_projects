<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_ems_seat_company" model="ir.rule">
            <field name="name">EMS seat: multi-company</field>
            <field name="model_id" ref="model_ems_seat"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ems_seat_hold_company" model="ir.rule">
            <field name="name">EMS seat hold: multi-company</field>
            <field name="model_id" ref="model_ems_seat_hold"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ems_seat_organizer" model="ir.rule">
            <field name="name">EMS seat: organizer may modify</field>
            <field name="model_id" ref="model_ems_seat"/>
            <field name="domain_force">[('event_id.ems_organizer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_user'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <record id="rule_ems_seat_manager" model="ir.rule">
            <field name="name">EMS seat: administrators may modify</field>
            <field name="model_id" ref="model_ems_seat"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_manager'))]"/>
            <field name="perm_read" eval="False"/>
        </record>
    </data>
</odoo>
