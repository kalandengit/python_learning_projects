<odoo>
  <record id="seat_list" model="ir.ui.view">
    <field name="name">ems.seat.list</field><field name="model">ems.seat</field>
    <field name="arch" type="xml"><list>
      <field name="event_id"/><field name="section"/><field name="row_label"/><field name="seat_number"/><field name="active"/>
    </list></field>
  </record>
  <record id="action_seats" model="ir.actions.act_window">
    <field name="name">Seats</field><field name="res_model">ems.seat</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_seats" name="Seating" parent="ems_core.menu_ems_root" action="action_seats" sequence="55"/>
</odoo>
