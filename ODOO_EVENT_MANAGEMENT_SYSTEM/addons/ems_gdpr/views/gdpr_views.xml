<odoo>
  <record id="gdpr_list" model="ir.ui.view">
    <field name="name">ems.gdpr.request.list</field><field name="model">ems.gdpr.request</field>
    <field name="arch" type="xml"><list>
      <field name="partner_id"/><field name="request_type"/><field name="state"/><field name="create_date"/>
    </list></field>
  </record>
  <record id="gdpr_form" model="ir.ui.view">
    <field name="name">ems.gdpr.request.form</field><field name="model">ems.gdpr.request</field>
    <field name="arch" type="xml"><form>
      <header>
        <button name="action_export" type="object" string="Export" invisible="request_type != 'export' or state != 'draft'"/>
        <button name="action_anonymize" type="object" string="Anonymize" invisible="request_type != 'anonymize' or state != 'draft'"/>
        <field name="state" widget="statusbar"/>
      </header>
      <sheet><group><field name="partner_id"/><field name="request_type"/><field name="result_json" readonly="1"/></group></sheet><chatter/>
    </form></field>
  </record>
  <record id="action_gdpr" model="ir.actions.act_window">
    <field name="name">GDPR Requests</field><field name="res_model">ems.gdpr.request</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_gdpr" name="GDPR" parent="ems_core.menu_ems_root" action="action_gdpr" sequence="90" groups="ems_core.group_ems_manager"/>
</odoo>
