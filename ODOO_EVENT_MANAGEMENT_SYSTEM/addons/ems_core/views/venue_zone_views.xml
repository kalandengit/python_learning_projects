<odoo>
  <record id="ems_zone_list" model="ir.ui.view">
    <field name="name">ems.venue.zone.list</field>
    <field name="model">ems.venue.zone</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/><field name="code"/><field name="event_id"/>
        <field name="capacity"/><field name="active"/>
      </list>
    </field>
  </record>
  <record id="ems_zone_form" model="ir.ui.view">
    <field name="name">ems.venue.zone.form</field>
    <field name="model">ems.venue.zone</field>
    <field name="arch" type="xml">
      <form><sheet><group>
        <field name="name"/><field name="code"/><field name="event_id"/>
        <field name="capacity"/><field name="active"/>
      </group></sheet></form>
    </field>
  </record>
  <record id="action_ems_zones" model="ir.actions.act_window">
    <field name="name">Venue Zones</field><field name="res_model">ems.venue.zone</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
