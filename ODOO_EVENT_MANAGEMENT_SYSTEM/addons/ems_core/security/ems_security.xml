<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Odoo 19 attaches groups to a res.groups.privilege; the Odoo <=18
             res.groups.category_id field no longer exists. -->
        <record id="res_groups_privilege_ems" model="res.groups.privilege">
            <field name="name">Event Management System</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_ems_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_ems"/>
            <field name="implied_ids" eval="[(4, ref('event.group_event_user'))]"/>
        </record>

        <record id="group_ems_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_ems"/>
            <field name="implied_ids" eval="[(4, ref('ems_core.group_ems_user')), (4, ref('event.group_event_manager'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!--
            Isolation model used across every EMS module:

            * a GLOBAL company rule (AND-ed with everything else) confines records
              to the companies the user has activated;
            * a MODIFICATION rule (perm_read=False) confines write/create/unlink to
              the event organizer, so operational staff can still read and scan
              tickets for events they do not own;
            * a widening rule for EMS administrators, because non-global rules are
              OR-ed across the groups a user belongs to.
        -->
        <record id="rule_ems_zone_company" model="ir.rule">
            <field name="name">EMS zone: multi-company</field>
            <field name="model_id" ref="model_ems_venue_zone"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_ems_zone_organizer" model="ir.rule">
            <field name="name">EMS zone: organizer may modify</field>
            <field name="model_id" ref="model_ems_venue_zone"/>
            <field name="domain_force">[('event_id.ems_organizer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_user'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <record id="rule_ems_zone_manager" model="ir.rule">
            <field name="name">EMS zone: administrators may modify</field>
            <field name="model_id" ref="model_ems_venue_zone"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_manager'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <!-- Organizer isolation on the native event object: EMS users may only
             modify the events they organize. Reading stays governed by the
             native event multi-company rule. -->
        <record id="rule_ems_event_organizer" model="ir.rule">
            <field name="name">EMS event: organizer may modify</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="domain_force">[('ems_organizer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_user'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <record id="rule_ems_event_manager" model="ir.rule">
            <field name="name">EMS event: administrators may modify</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_manager'))]"/>
            <field name="perm_read" eval="False"/>
        </record>
    </data>
</odoo>
