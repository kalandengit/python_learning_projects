<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="mail_template_ticket_issued" model="mail.template">
      <field name="name">EMS: Ticket Issued</field>
      <field name="model_id" ref="ems_ticketing.model_ems_ticket"/>
      <field name="subject">Your ticket for {{ object.event_id.name }}</field>
      <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
      <field name="partner_to">{{ object.partner_id.id }}</field>
      <field name="body_html" type="html">
        <div style="margin:0px;padding:0px;font-size:13px;">
          <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
          <p>
            Your ticket <strong t-out="object.name or ''"/> for
            <strong t-out="object.event_id.name or ''"/> has been issued.
          </p>
          <p>
            Open <em>My Tickets</em> in the portal to display your entry QR code.
            The code is generated fresh each time and expires within minutes, so
            display it at the gate rather than saving a screenshot.
          </p>
          <p>See you there.</p>
        </div>
      </field>
      <field name="lang">{{ object.partner_id.lang }}</field>
      <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_waitlist_offer" model="mail.template">
      <field name="name">EMS: Waitlist Offer</field>
      <field name="model_id" ref="ems_waitlist.model_ems_waitlist_entry"/>
      <field name="subject">A place opened up for {{ object.event_id.name }}</field>
      <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
      <field name="partner_to">{{ object.partner_id.id }}</field>
      <field name="body_html" type="html">
        <div style="margin:0px;padding:0px;font-size:13px;">
          <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
          <p>
            A place has opened up for <strong t-out="object.event_id.name or ''"/>
            and it is being held for you until
            <strong t-out="object.offer_expires_at or ''"/>.
          </p>
          <p>Confirm before then, or the place goes to the next person in line.</p>
        </div>
      </field>
      <field name="lang">{{ object.partner_id.lang }}</field>
      <field name="auto_delete" eval="True"/>
    </record>
  </data>
</odoo>
