<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Portal home card -->
  <template id="portal_my_home_ems" name="Portal My Home: EMS tickets"
            inherit_id="portal.portal_my_home" priority="30">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <div class="o_portal_category row g-2 mt-3">
        <t t-call="portal.portal_docs_entry">
          <t t-set="title">Event Tickets</t>
          <t t-set="text">Display the QR code for your upcoming events</t>
          <t t-set="url" t-value="'/my/ems/tickets'"/>
          <t t-set="placeholder_count" t-value="'ems_ticket_count'"/>
        </t>
      </div>
    </xpath>
  </template>

  <!-- Breadcrumb entries -->
  <template id="portal_ems_breadcrumb" name="EMS ticket breadcrumb"
            inherit_id="portal.portal_breadcrumbs" priority="30">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li t-if="page_name == 'ems_tickets'" class="breadcrumb-item">
        <a t-if="ticket" href="/my/ems/tickets">Event Tickets</a>
        <span t-else="">Event Tickets</span>
      </li>
      <li t-if="ticket" class="breadcrumb-item active">
        <span t-out="ticket['name']"/>
      </li>
    </xpath>
  </template>

  <template id="portal_my_ems_tickets" name="My EMS Tickets">
    <t t-call="portal.portal_layout">
      <h3 class="mb-3">Event Tickets</h3>
      <t t-if="not tickets">
        <div class="alert alert-info" role="alert">You have no event tickets yet.</div>
      </t>
      <t t-else="">
        <t t-call="portal.portal_table">
          <thead>
            <tr>
              <th>Ticket</th>
              <th>Event</th>
              <th>Date</th>
              <th class="text-end">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="tickets" t-as="ticket">
              <td>
                <a t-attf-href="/my/ems/ticket/#{ticket['public_uid']}">
                  <span t-out="ticket['name']"/>
                </a>
              </td>
              <td t-out="ticket['event_name']"/>
              <td t-out="ticket['event_date_begin']" t-options="{'widget': 'datetime'}"/>
              <td class="text-end">
                <span class="badge rounded-pill text-bg-secondary" t-out="ticket['state']"/>
              </td>
            </tr>
          </tbody>
        </t>
      </t>
    </t>
  </template>

  <template id="portal_ems_ticket" name="EMS Ticket">
    <t t-call="portal.portal_layout">
      <div class="row">
        <div class="col-12 col-lg-8">
          <h3 t-out="ticket['event_name']"/>
          <ul class="list-unstyled">
            <li><strong>Ticket:</strong> <span t-out="ticket['name']"/></li>
            <li><strong>Attendee:</strong> <span t-out="ticket['attendee']"/></li>
            <li><strong>Status:</strong> <span t-out="ticket['state']"/></li>
            <li t-if="ticket['seat_label']"><strong>Seat:</strong> <span t-out="ticket['seat_label']"/></li>
            <li>
              <strong>Starts:</strong>
              <span t-out="ticket['event_date_begin']" t-options="{'widget': 'datetime'}"/>
            </li>
          </ul>
        </div>
        <div class="col-12 col-lg-4 text-center">
          <t t-if="has_envelope">
            <img t-attf-src="/my/ems/ticket/#{ticket['public_uid']}/qr.png"
                 alt="Entry QR code" class="img-fluid" style="max-width: 260px;"/>
            <p class="text-muted small mt-2">
              This code expires within minutes. Reload the page at the gate
              instead of using a screenshot.
            </p>
          </t>
          <t t-elif="error">
            <div class="alert alert-warning" role="alert" t-out="error"/>
          </t>
          <t t-else="">
            <div class="alert alert-secondary" role="alert">
              No entry code: this ticket is <span t-out="ticket['state']"/>.
            </div>
          </t>
        </div>
      </div>
      <a class="btn btn-secondary mt-3" href="/my/ems/tickets">Back to my tickets</a>
    </t>
  </template>
</odoo>
