<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Internal staff: confined to their activated companies. -->
        <record id="rule_ems_ticket_company" model="ir.rule">
            <field name="name">EMS ticket: multi-company</field>
            <field name="model_id" ref="model_ems_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_user'))]"/>
        </record>

        <!-- Only the organizer of the event may modify its tickets; reading is
             left to the company rule so gate staff can scan any event. -->
        <record id="rule_ems_ticket_organizer" model="ir.rule">
            <field name="name">EMS ticket: organizer may modify</field>
            <field name="model_id" ref="model_ems_ticket"/>
            <field name="domain_force">[('event_id.ems_organizer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_user'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <record id="rule_ems_ticket_manager" model="ir.rule">
            <field name="name">EMS ticket: administrators may modify</field>
            <field name="model_id" ref="model_ems_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ems_core.group_ems_manager'))]"/>
            <field name="perm_read" eval="False"/>
        </record>

        <!-- Portal attendees may only ever see their own tickets. This is what
             keeps /my/ems/tickets from exposing another user's ticket. -->
        <record id="rule_ems_ticket_portal" model="ir.rule">
            <field name="name">EMS ticket: portal owner only</field>
            <field name="model_id" ref="model_ems_ticket"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
