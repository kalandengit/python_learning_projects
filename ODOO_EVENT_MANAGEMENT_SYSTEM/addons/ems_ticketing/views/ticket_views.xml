<odoo>
  <record id="ticket_list" model="ir.ui.view">
    <field name="name">ems.ticket.list</field><field name="model">ems.ticket</field>
    <field name="arch" type="xml"><list>
      <field name="name"/><field name="event_id"/><field name="partner_id"/>
      <field name="registration_id"/><field name="state"/><field name="token_version"/>
    </list></field>
  </record>
  <record id="ticket_form" model="ir.ui.view">
    <field name="name">ems.ticket.form</field><field name="model">ems.ticket</field>
    <field name="arch" type="xml"><form>
      <header>
        <button name="action_rotate" type="object" string="Rotate Credential"/>
        <button name="action_revoke" type="object" string="Revoke"/>
        <field name="state" widget="statusbar"/>
      </header>
      <sheet><group>
        <field name="name"/><field name="event_id"/><field name="partner_id"/>
        <field name="registration_id"/><field name="public_uid" readonly="1"/>
        <field name="token_version" readonly="1"/>
      </group></sheet><chatter/>
    </form></field>
  </record>
  <record id="action_ems_ticket" model="ir.actions.act_window">
    <field name="name">Tickets</field><field name="res_model">ems.ticket</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_ems_ticket" name="Tickets" parent="ems_core.menu_ems_root"
            action="action_ems_ticket" sequence="30"/>
</odoo>
